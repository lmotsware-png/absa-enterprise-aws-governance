# ============================================
# SECRET 4 — Docker Hub Credentials (Week 9)
# ============================================
# Used by: ECR pull-through cache for Docker Hub
# Used by: Week 9 CodeBuild to authenticate to Docker Hub
# 
# IMPORTANT: This secret is NOT populated by Terraform.
# You must set the value manually after apply:
# 
# aws secretsmanager put-secret-value \
#   --secret-id absa/devops/docker-hub-credentials \
#   --secret-string '{"username":"your-dockerhub-username","accessToken":"your-access-token"}'
# 
# Why not populate in Terraform?
#   - Docker Hub credentials are generated by Docker Hub, not by Terraform
#   - The access token must be created in Docker Hub's interface
#   - Never store credentials in Terraform code
#   - Manual population is the secure approach

resource "aws_secretsmanager_secret" "docker_hub_credentials" {
  name        = "absa/devops/docker-hub-credentials"
  description = "Docker Hub credentials for ECR pull-through cache"
  kms_key_id  = aws_kms_key.secrets.key_id
  recovery_window_in_days = 30

  tags = merge(local.common_tags, {
    Name = "ABSA-Docker-Hub-Credentials"
    Purpose = "DevOps"
  })
}

# NOTE: No random_password for Docker Hub credentials.
# The token must be generated manually in Docker Hub.

# NOTE: No secret_version for Docker Hub credentials.
# The value must be set manually using AWS CLI:
# 
# aws secretsmanager put-secret-value \
#   --secret-id absa/devops/docker-hub-credentials \
#   --secret-string '{"username":"your-dockerhub-username","accessToken":"your-access-token"}'

# ============================================
# SECRET 5 — Infracost API Key (Week 9)
# ============================================
# Used by: buildspec_terraform.yml for cost estimation
# Used by: Week 9 Terraform validation pipeline
# 
# IMPORTANT: This secret is NOT populated by Terraform.
# You must set the value manually after apply:
# 
# aws secretsmanager put-secret-value \
#   --secret-id absa/devops/infracost-api-key \
#   --secret-string '{"api_key":"your-infracost-api-key"}'
# 
# Infracost API key is generated by Infracost (not by AWS/Terraform)
# Sign up at: https://www.infracost.io/

resource "aws_secretsmanager_secret" "infracost_api_key" {
  name        = "absa/devops/infracost-api-key"
  description = "Infracost API key for Terraform cost estimation"
  kms_key_id  = aws_kms_key.secrets.key_id
  recovery_window_in_days = 30

  tags = merge(local.common_tags, {
    Name = "ABSA-Infracost-API-Key"
    Purpose = "DevOps"
  })
}

# NOTE: No random_password for Infracost API key.
# The API key must be generated manually in Infracost.

# NOTE: No secret_version for Infracost API key.
# The value must be set manually using AWS CLI:
# 
# aws secretsmanager put-secret-value \
#   --secret-id absa/devops/infracost-api-key \
#   --secret-string '{"api_key":"your-infracost-api-key"}'