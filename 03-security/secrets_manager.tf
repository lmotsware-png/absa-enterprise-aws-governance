# ============================================
# AWS Secrets Manager — Secure Credential Storage
# ============================================
# This file creates ALL secrets used across the entire project.
# 
# Secrets 1-3: Created in Week 3 (Production)
# Secrets 4-5: Created in Week 3 (DevOps — used by Week 9)
# 
# The actual values for Secrets 4-5 must be set manually after apply.
# Terraform creates the secret containers, but you populate the values.

# ============================================
# SECRET 1 — RDS Master Password
# ============================================
# Used by: Payment-api pod at startup (Stage 6C)
# Used by: Week 5 RDS Aurora cluster
# Password: 32 chars, special characters allowed

resource "aws_secretsmanager_secret" "rds_master" {
  name        = "absa/rds/master-password"
  description = local.secrets.rds_master_password.description
  kms_key_id  = aws_kms_key.secrets.key_id
  recovery_window_in_days = 7

  tags = merge(local.common_tags, {
    Name = "ABSA-RDS-Master-Password"
  })
}

resource "random_password" "rds_master" {
  length           = 32
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"
  min_special      = 4
  min_upper        = 4
  min_lower        = 4
  min_numeric      = 4
}

resource "aws_secretsmanager_secret_version" "rds_master" {
  secret_id     = aws_secretsmanager_secret.rds_master.id
  secret_string = jsonencode({
    username = "absa_admin"
    password = random_password.rds_master.result
    engine   = "aurora-postgresql"
    host     = "absa-rds-cluster.cluster-abcdefg.eu-west-1.rds.amazonaws.com"
    port     = "5432"
  })
}

